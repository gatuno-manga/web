{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useImportType": "off"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
			"a11y": {
				"useAltText": "warn",
				"useButtonType": "warn",
				"useAnchorContent": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf",
		"lineWidth": 80,
		"attributePosition": "auto"
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		},
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all"
		}
	},
	"html": {
		"parser": {
			"interpolation": true
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/.angular",
			"!**/coverage",
			"!**/*.html",
			"!**/*.md",
			"!**/*.svg",
			"!**/*.scss",
			"!**/*.css",
			"!**/*.yml",
			"!**/*.yaml",
			"!**/.agents",
			"!src/app/core/constants/icons.constant.ts"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.spec.ts", "**/*.e2e-spec.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["src/app/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@ui/**",
											"@ui/*",
											"@shared/ui/**",
											"@shared/ui/*",
											"@features/**",
											"@features/*",
											"@pages/**",
											"@pages/*",
											"../*/ui/**",
											"../*/shared/ui/**",
											"../*/features/**",
											"../*/pages/**"
										],
										"message": "Core cannot import from UI, Shared, Features, or Pages."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/app/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@features/**",
											"@features/*",
											"@pages/**",
											"@pages/*",
											"../*/features/**",
											"../*/pages/**"
										],
										"message": "Shared cannot import from Features or Pages."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/app/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@pages/**",
											"@pages/*",
											"../*/pages/**"
										],
										"message": "Features cannot import from Pages."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
