{
	"name": "front",
	"version": "0.8.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"start:docker": "ng serve --host 0.0.0.0 --poll 2000",
		"prestart": "npm run build:icons",
		"prebuild": "npm run build:icons && node generate-env.ts",
		"build:icons": "node scripts/build-icons.js",
		"build": "ng build",
		"lint": "biome check . && secretlint \"**/*\"",
		"check:dead-code": "knip",
		"check:icons": "node scripts/detect-missing-icons.js",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"test:headless": "ng test --browsers=ChromeHeadlessCI --watch=false",
		"audit": "npm audit --omit=dev --audit-level=high",
		"api:docs": "node scripts/swagger-helper.mjs",
		"api:graphql": "node scripts/graphql-helper.mjs",
		"serve:ssr:front": "node dist/front/server/server.mjs"
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "^21.2.25",
		"@angular/cdk": "^21.2.14",
		"@angular/common": "^21.2.25",
		"@angular/compiler": "^21.2.25",
		"@angular/core": "^21.2.25",
		"@angular/forms": "^21.2.25",
		"@angular/platform-browser": "^21.2.25",
		"@angular/platform-browser-dynamic": "^21.2.25",
		"@angular/platform-server": "^21.2.25",
		"@angular/router": "^21.2.25",
		"@angular/service-worker": "^21.2.25",
		"@angular/ssr": "^21.2.24",
		"@simplewebauthn/browser": "^13.2.2",
		"@types/cookie-parser": "^1.4.10",
		"blurhash": "^2.0.5",
		"cookie-parser": "^1.4.7",
		"echarts": "^6.1.0",
		"express": "^4.22.3",
		"idb": "^8.0.3",
		"jwt-decode": "^4.0.0",
		"mqtt": "^5.15.1",
		"ng2-pdf-viewer": "^10.4.0",
		"ngx-cookie-service": "^21.0.0",
		"ngx-cookie-service-ssr": "^21.0.0",
		"ngx-echarts": "^21.0.0",
		"ngx-markdown": "^21.3.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^21.2.24",
		"@angular/cli": "^21.2.24",
		"@angular/compiler-cli": "^21.2.25",
		"@biomejs/biome": "^2.4.15",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.8",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/express": "^4.17.17",
		"@types/jasmine": "~5.1.0",
		"@types/node": "^24.0.0",
		"baseline-browser-mapping": "^2.9.19",
		"chokidar": "^5.0.0",
		"jasmine-core": "~5.6.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"knip": "^6.13.1",
		"secretlint": "^13.0.0",
		"semantic-release": "^25.0.3",
		"typescript": "~5.9.3"
	}
}
